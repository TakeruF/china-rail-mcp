{
  "name": "china-rail-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.takeruf/china-rail-mcp",
  "description": "Read-only MCP server for Chinese railway schedules, fares, stops, and seat availability.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TakeruF/china-rail-mcp.git"
  },
  "homepage": "https://github.com/TakeruF/china-rail-mcp#readme",
  "bugs": {
    "url": "https://github.com/TakeruF/china-rail-mcp/issues"
  },
  "type": "module",
  "bin": {
    "china-rail-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs/SELF_HOSTING.md",
    "docs/SELF_HOSTING.en.md",
    "scripts",
    "server.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "china-rail",
    "12306",
    "railway"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "doctor": "node scripts/doctor.mjs",
    "generate:secret": "node scripts/generate-secret.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "smoke:stdio": "node scripts/smoke-stdio.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.edgeone.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "cross-env RUN_LIVE_12306=1 vitest run tests/integration.test.ts",
    "verify": "npm run doctor && npm run lint && npm run typecheck && npm test && npm run build && npm run smoke:stdio && npm run format && npm audit",
    "verify:live": "npm run verify && npm run test:integration",
    "package:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.3",
    "cross-env": "^10.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.11"
  }
}
